<figure
  class="blockquote-container relative -mx-4 md:mx-0 mb-6 flex gap-3 md:rounded-r-lg bg-slate-50 border-[1px] border-l-[3px] border-slate-300 border-l-slate-800"
>
  <blockquote
    class="relative w-full px-4 md:px-6 py-4 text-[15px] md:text-base leading-7 text-slate-700"
  >
    <span
      aria-hidden="true"
      class="pointer-events-none absolute right-3 top-1 -z-0 select-none font-serif text-5xl leading-none text-slate-900/[0.07]"
      >&rdquo;</span
    >
    <slot />
  </blockquote>
</figure>

<style is:global>
  .blockquote-container blockquote > p + p {
    margin-top: 0.75rem !important;
  }

  .blockquote-container blockquote > :last-child {
    margin-bottom: 0 !important;
  }

  .blockquote-container .blockquote-container {
    margin: 1rem 0 0;
  }
</style>
